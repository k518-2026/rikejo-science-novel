# ==========================================
# rikejo-science-novel 設定テンプレート
# ==========================================
# このファイルを .env にコピーして、実際の認証情報を入力してください。
# copy .env.example .env

# --- Mac mini ローカルLLM (Ollama) 分業システム設定 ---
OLLAMA_HOST=http://192.168.128.59:11434
# 構成作家（プロット作成・設定管理・章の構成・科学解説）
OLLAMA_DIRECTOR_MODEL=qwen2.5:14b
# 執筆作家（情緒豊かな地の文・五感描写・セリフの執筆）
OLLAMA_WRITER_MODEL=gemma2:9b

# --- SMTP 送信サーバー設定 ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 送信者名（表示名）
MAIL_FROM_NAME=Rikejo Science Novel Publisher

# --- WordPress メール投稿 受信設定 ---
# Jetpackの「メールによる投稿」または Postie 等で発行された専用アドレス
WP_POST_EMAIL=your_wordpress_post_email@post.wordpress.com

# --- Google Blogger メール投稿 受信設定（任意） ---
BLOGGER_POST_EMAIL=

# --- 投稿オプション ---
DEFAULT_POST_STATUS=publish
USE_JETPACK_SHORTCODES=true
