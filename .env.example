# ==========================================
# rikejo-science-novel 設定テンプレート
# ==========================================
# このファイルを .env にコピーして、実際の認証情報を入力してください。
# copy .env.example .env

# --- ハイブリッド並列ローカルLLM (主系: RTX5060LP .62 / 副系: Mac mini .59) 分業システム設定 ---
OLLAMA_HOST=http://192.168.128.62:11434
# 構成作家（プロット作成・設定管理・章の構成・科学解説・教職キャリアガイド）
OLLAMA_DIRECTOR_MODEL=qwen3.5:9b
# 執筆作家（小説本文の執筆専用カスタムモデル shosetsu）
OLLAMA_WRITER_MODEL=shosetsu
# 挿絵・画像生成サーバー (Draw Things HTTP API / FLUX.2 [klein] 4B)
DRAW_THINGS_HOST=http://192.168.128.59:7860

# --- SMTP 送信サーバー設定 ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 送信者名（表示名）
MAIL_FROM_NAME=Rikejo Science Novel Publisher

# --- Google Blogger メール投稿 受信設定（メイン投稿先） ---
# Blogger管理画面「設定」→「メール」→「メールを使用して投稿する」で設定した専用アドレスを指定します。
# 例: kouy.secret_words@blogger.com
BLOGGER_POST_EMAIL=your_username.secret_words@blogger.com

# --- WordPress メール投稿 受信設定（任意・併用する場合のみ） ---
WP_POST_EMAIL=

# --- 投稿オプション ---
DEFAULT_POST_STATUS=publish
USE_JETPACK_SHORTCODES=false
